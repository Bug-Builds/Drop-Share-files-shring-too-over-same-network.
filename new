<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>DropShare</title>
<style>
:root{color-scheme:light;--bg:#F2F7FB;--card:#fff;--ink:#0E2339;--soft:#5E7389;--line:#DAE4EE;--a:#2F6BFF;--b:#12B8A6;--ok:#16A34A;--bad:#E5484D;--tint:#E8F1FF;--tint-line:#CFE0F8;
  padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*{box-sizing:border-box}[hidden]{display:none!important}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.45 ui-rounded,"SF Pro Rounded",system-ui,-apple-system,"Segoe UI",sans-serif}
main{max-width:520px;margin:0 auto;padding:18px 16px 48px}
header{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}
.brand{display:flex;align-items:center;gap:10px;font-size:1.25rem;font-weight:700;letter-spacing:-.02em}
.card{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:18px;margin-top:14px}
h2{font-size:1rem;margin:0}p{margin:0;color:var(--soft)}
.pill{display:inline-flex;gap:7px;align-items:center;padding:5px 12px;border-radius:999px;border:1px solid var(--line);font-size:.8rem;font-weight:600;color:var(--soft);background:var(--card)}
.pill::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--line)}
.pill.on{color:var(--ok)}.pill.on::before{background:var(--ok);animation:beat 1.6s infinite}
@keyframes beat{0%{box-shadow:0 0 0 0 color-mix(in srgb,var(--ok) 55%,transparent)}100%{box-shadow:0 0 0 9px transparent}}

/* The link stage: two devices, one beam. Packets travel the beam while files move. */
.stage{background:var(--tint);border-color:var(--tint-line);display:grid;grid-template-columns:76px 1fr 76px;align-items:start;padding:24px 16px 16px;border-radius:28px;margin-top:0}
.node{text-align:center}.node small{display:block;margin-top:8px;font-weight:600;font-size:.8rem;overflow-wrap:anywhere}
.orb{width:76px;height:76px;border-radius:50%;display:grid;place-items:center;color:#fff;background:var(--a);position:relative}
.peer .orb{background:var(--b)}
.peer.ghost .orb{background:#fff;border:2px dashed #A9C3E8;color:#7C93AE}
.peer.ghost.wait .orb::after{content:"";position:absolute;inset:-2px;border-radius:50%;border:2px solid var(--b);animation:ping 1.6s ease-out infinite}
.beam{position:relative;height:3px;margin:37px 8px 0;border-radius:2px;background:repeating-linear-gradient(90deg,#A9C3E8 0 6px,transparent 6px 12px);animation:march 1s linear infinite}
.live .beam{background:linear-gradient(90deg,var(--a),var(--b));animation:none}
.live .orb{animation:pop .6s cubic-bezier(.3,1.6,.5,1)}
.beam::after{content:"";position:absolute;left:50%;top:50%;width:14px;height:14px;margin:-7px;border-radius:50%;border:2px solid var(--a);opacity:0}
.boom .beam::after{animation:ping 1s ease-out}
.pk{position:absolute;top:50%;width:9px;height:9px;margin-top:-4px;border-radius:50%;opacity:0}
.pk.o{background:var(--a)}.pk.i{background:var(--b)}
.f-out .pk.o{animation:fo 1.1s linear infinite;animation-delay:calc(var(--n)*.27s)}
.f-in .pk.i{animation:fi 1.1s linear infinite;animation-delay:calc(var(--n)*.27s)}
@keyframes fo{0%{left:0;opacity:0}15%,85%{opacity:1}100%{left:100%;opacity:0}}
@keyframes fi{0%{left:100%;opacity:0}15%,85%{opacity:1}100%{left:0;opacity:0}}
@keyframes march{to{background-position:12px 0}}
@keyframes ping{from{transform:scale(.4);opacity:.9}to{transform:scale(9);opacity:0}}
.peer.ghost.wait .orb::after{animation-name:ring}
@keyframes ring{from{transform:scale(1);opacity:.9}to{transform:scale(1.6);opacity:0}}
@keyframes pop{0%{transform:scale(.8)}100%{transform:scale(1)}}

/* Pairing */
.seg{position:relative;display:grid;grid-template-columns:1fr 1fr;background:var(--bg);border-radius:999px;padding:4px}
.seg button{position:relative;z-index:1;background:none;border:0;color:var(--soft);font-family:inherit;font-weight:600;font-size:.9rem;padding:9px;cursor:pointer;border-radius:999px;transition:color .2s}
.seg button.on{color:var(--ink)}
.seg i{position:absolute;top:4px;bottom:4px;left:4px;width:calc(50% - 4px);background:var(--card);border-radius:999px;transition:transform .35s cubic-bezier(.3,1.3,.5,1);box-shadow:0 1px 3px rgba(0,0,0,.15)}
.seg[data-t=join] i{transform:translateX(100%)}
.pane{text-align:center;padding-top:16px}
.digits{display:flex;gap:8px;justify-content:center;margin:16px 0}
.digits span,.digits input{width:44px;height:58px;border-radius:14px;border:1.5px solid var(--line);background:var(--bg);display:grid;place-items:center;font:700 1.7rem ui-rounded,system-ui,sans-serif;text-align:center;color:var(--ink);overflow:hidden;padding:0;font-variant-numeric:tabular-nums}
.digits span b{display:block;animation:roll .65s cubic-bezier(.2,.9,.3,1.2) both;animation-delay:calc(var(--i)*70ms)}
@keyframes roll{from{transform:translateY(-130%);filter:blur(4px);opacity:0}}
.digits input:focus{border-color:var(--a);outline:3px solid color-mix(in srgb,var(--a) 28%,transparent)}
.shake{animation:shake .4s}@keyframes shake{25%{transform:translateX(-7px)}75%{transform:translateX(7px)}}
.btn{display:inline-block;font-family:inherit;font-weight:600;font-size:.95rem;padding:11px 22px;border-radius:999px;border:0;background:var(--a);color:#fff;cursor:pointer;text-decoration:none;transition:transform .15s}
.btn:hover{transform:translateY(-1px)}.btn:active{transform:scale(.96)}
.btn.sm{padding:6px 14px;font-size:.82rem}.btn.alt{background:var(--bg);color:var(--ink)}
button:focus-visible,.btn:focus-visible,.drop:focus-visible,.tbox input:focus-visible{outline:3px solid var(--b);outline-offset:2px}
#err{color:var(--bad);font-size:.9rem;min-height:1.3em;margin-top:10px;text-align:center}
.dots span{display:inline-block;animation:dot 1.2s infinite}.dots span:nth-child(2){animation-delay:.2s}.dots span:nth-child(3){animation-delay:.4s}
@keyframes dot{50%{transform:translateY(-4px);opacity:.4}}
.note{font-size:.78rem;text-align:center;margin-top:12px}

/* Send + activity */
.drop{display:grid;justify-items:center;gap:2px;padding:28px 16px;border-radius:24px;border:2px dashed var(--line);background:var(--card);cursor:pointer;text-align:center;margin-top:14px;transition:transform .2s,border-color .2s,background .2s}
.drop svg{color:var(--a);animation:bob 2.4s ease-in-out infinite}.drop b{margin-top:6px}
@keyframes bob{50%{transform:translateY(-6px)}}
.drop.over,.dragging .drop{border-color:var(--a);background:var(--tint);transform:scale(1.02)}
.tbox{display:flex;gap:8px}.tbox input{flex:1;min-width:0;font:inherit;padding:11px 16px;border-radius:999px;border:1.5px solid var(--line);background:var(--bg);color:var(--ink)}
.empty{color:var(--soft);font-size:.9rem;padding-top:8px}
.item{display:grid;grid-template-columns:46px 1fr auto;gap:12px;align-items:center;padding:12px;border:1px solid var(--line);border-radius:16px;margin-top:10px;animation:in .45s cubic-bezier(.2,.9,.3,1.1)}
@keyframes in{from{opacity:0;transform:translateY(-12px) scale(.96)}}
.ico{width:46px;height:46px;border-radius:13px;display:grid;place-items:center;font-weight:700;font-size:.68rem;color:#fff;background:hsl(var(--h,220) 68% 50%) center/cover;position:relative}
.ico::after{position:absolute;right:-5px;bottom:-5px;width:20px;height:20px;border-radius:50%;display:grid;place-items:center;font-size:.75rem;border:2px solid var(--card);color:#fff}
.out .ico::after{content:"↑";background:var(--a)}.in .ico::after{content:"↓";background:var(--b)}
.meta{min-width:0}.name{font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sub{color:var(--soft);font-size:.78rem;font-variant-numeric:tabular-nums}
.txt{white-space:pre-wrap;overflow-wrap:anywhere;margin:0}.txt a{color:var(--a)}
.bar{height:5px;border-radius:3px;background:var(--bg);margin-top:7px;overflow:hidden;transition:height .3s,margin .3s,opacity .3s}
.bar i{display:block;height:100%;width:0;border-radius:3px;background:linear-gradient(90deg,var(--a),var(--b),var(--a));background-size:200% 100%;animation:shine 1.2s linear infinite;transition:width .12s}
@keyframes shine{to{background-position:-200% 0}}
.done .bar{height:0;margin-top:0;opacity:0}.fail .sub{color:var(--bad)}
.act{display:flex;align-items:center;gap:8px}
.chk{width:30px;height:30px;color:var(--ok)}.chk path{stroke-dasharray:24;stroke-dashoffset:24;animation:draw .5s .1s forwards}
@keyframes draw{to{stroke-dashoffset:0}}
@media (prefers-reduced-motion:reduce){*{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
</style>
</head>
<body>
<main>
  <header>
    <div class="brand"><svg width="30" height="30" viewBox="0 0 30 30" fill="none" aria-hidden="true"><circle cx="11" cy="15" r="8" fill="#2F6BFF"/><circle cx="19" cy="15" r="8" fill="#12B8A6" style="mix-blend-mode:multiply"/></svg>DropShare</div>
    <span id="pill" class="pill" role="status">Not connected</span>
  </header>

  <section class="card stage" id="stage" aria-label="Connection">
    <div class="node"><div class="orb" id="meOrb"></div><small id="meName"></small></div>
    <div class="beam" id="beam"></div>
    <div class="node peer ghost" id="peerNode"><div class="orb" id="peerOrb"></div><small id="peerName">No device yet</small></div>
  </section>

  <section id="pair" class="card">
    <div class="seg" id="seg" data-t="host"><i></i><button class="on" data-t="host">Show my code</button><button data-t="join">Enter a code</button></div>
    <div id="pHost" class="pane">
      <p>Open DropShare on the other device, choose <b>Enter a code</b>, and type this.</p>
      <div class="digits" id="digits" aria-live="polite"></div>
      <button class="btn" id="bHost">Generate code</button>
      <p id="waiting" hidden>Waiting for the other device<span class="dots"><span>.</span><span>.</span><span>.</span></span></p>
    </div>
    <div id="pJoin" class="pane" hidden>
      <p>Type the 6-digit code shown on the other device.</p>
      <div class="digits" id="joinDigits"></div>
      <p id="joining" hidden>Connecting<span class="dots"><span>.</span><span>.</span><span>.</span></span></p>
    </div>
    <div id="err" role="alert"></div>
    <p class="note">Both devices need internet to connect. Files then go directly between them and are never uploaded.</p>
  </section>

  <section id="app" hidden>
    <div class="drop" id="drop" tabindex="0" role="button" aria-label="Choose files to send">
      <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5M5 15v3.5A1.5 1.5 0 0 0 6.5 20h11a1.5 1.5 0 0 0 1.5-1.5V15"/></svg>
      <b>Drop files to send</b><span class="sub">or tap to choose</span>
    </div>
    <input type="file" id="picker" multiple hidden>
    <div class="card tbox"><input id="text" placeholder="Send a message or link" aria-label="Message"><button class="btn" id="bText">Send</button></div>
    <div class="card"><h2>Activity</h2><div id="log"><div class="empty">Files and messages will appear here.</div></div></div>
  </section>
</main>

<script src="https://cdn.jsdelivr.net/npm/peerjs@1.5.4/dist/peerjs.min.js"></script>
<script>
'use strict';
const $ = (s) => document.querySelector(s);
const mk = (t, c, h) => { const e = document.createElement(t); if (c) e.className = c; if (h != null) e.innerHTML = h; return e; };
const pick = (a) => a[Math.random() * a.length | 0];
const me = { name: pick(['Blue','Swift','Calm','Brave','Lucky','Amber','Misty','Sunny']) + ' ' + pick(['Fox','Otter','Panda','Heron','Lynx','Koala','Falcon','Gecko']),
  kind: /iPhone|Android|Mobile/i.test(navigator.userAgent) ? 'phone' : 'laptop' };
const sv = (d) => `<svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`;
const IC = {
  phone: sv('<rect x="7" y="2.5" width="10" height="19" rx="2.5"/><path d="M11 18.5h2"/>'),
  laptop: sv('<rect x="3.5" y="4.5" width="17" height="11" rx="2"/><path d="M2 19.5h20"/>'),
  chk: '<svg class="chk" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" opacity=".25"/><path d="M7 12.5l3.2 3.2L17 9"/></svg>',
};
const CHUNK = 16384, HIGH = 4 << 20;
const size = (n) => n < 1024 ? n + ' B' : n < 1048576 ? (n / 1024).toFixed(1) + ' KB' : n < 1073741824 ? (n / 1048576).toFixed(1) + ' MB' : (n / 1073741824).toFixed(2) + ' GB';
const fail = (m) => { $('#err').textContent = m || ''; };
let peer, conn, dc, cur = null;

$('#meOrb').innerHTML = IC[me.kind]; $('#peerOrb').innerHTML = IC.laptop; $('#meName').textContent = me.name;
const stage = $('#stage'), beam = $('#beam');
for (let n = 0; n < 4; n++) for (const k of ['o', 'i']) { const p = mk('span', 'pk ' + k); p.style.setProperty('--n', n); beam.append(p); }
const fl = { out: 0, in: 0 };
function flow(d, n) { fl[d] += n; stage.classList.toggle('f-out', fl.out > 0); stage.classList.toggle('f-in', fl.in > 0); }

/* ---------- pairing UI ---------- */
$('#seg').onclick = (e) => {
  const b = e.target.closest('button'); if (!b) return; fail('');
  $('#seg').dataset.t = b.dataset.t;
  $('#seg').querySelectorAll('button').forEach((x) => x.classList.toggle('on', x === b));
  $('#pHost').hidden = b.dataset.t !== 'host'; $('#pJoin').hidden = b.dataset.t !== 'join';
  if (b.dataset.t === 'join') jin[0].focus();
};
const cells = [...Array(6)].map(() => { const s = mk('span', '', '·'); $('#digits').append(s); return s; });
function showCode(code) { cells.forEach((s, i) => { s.innerHTML = ''; const b = mk('b', '', code[i]); b.style.setProperty('--i', i); s.append(b); }); }
const jin = [...Array(6)].map((_, i) => {
  const n = mk('input'); n.inputMode = 'numeric'; n.maxLength = 1; n.autocomplete = 'off'; n.ariaLabel = 'Digit ' + (i + 1);
  $('#joinDigits').append(n);
  n.oninput = () => { n.value = n.value.replace(/\D/g, ''); if (n.value && i < 5) jin[i + 1].focus(); if (jin.every((x) => x.value)) join(); };
  n.onkeydown = (e) => { if (e.key === 'Backspace' && !n.value && i > 0) jin[i - 1].focus(); };
  n.onpaste = (e) => {
    const d = (e.clipboardData.getData('text') || '').replace(/\D/g, '').slice(0, 6); if (!d) return;
    e.preventDefault(); [...d].forEach((c, k) => (jin[k].value = c)); d.length === 6 ? join() : jin[d.length].focus();
  };
  return n;
});

/* ---------- connection ---------- */
const OPTS = { serialization: 'raw', reliable: true }, ID = (c) => 'dsl-' + c;
function waiting(on) { $('#peerNode').classList.toggle('wait', on); }
function attach(c) {
  conn = c;
  c.on('open', () => {
    dc = c.dataChannel; dc.bufferedAmountLowThreshold = 1 << 20;
    $('#pair').hidden = true; $('#app').hidden = false; waiting(false);
    stage.classList.add('live', 'boom'); $('#peerNode').classList.remove('ghost');
    $('#pill').textContent = 'Connected'; $('#pill').className = 'pill on';
    $('#peerName').textContent = 'Device connected';
    c.send(JSON.stringify({ t: 'hello', name: me.name, kind: me.kind }));
  });
  c.on('data', (d) => onMsg({ data: d }));
  c.on('close', () => {
    stage.classList.remove('live', 'f-out', 'f-in'); $('#peerNode').classList.add('ghost');
    $('#pill').textContent = 'Disconnected. Tap to reload'; $('#pill').className = 'pill'; $('#pill').onclick = () => location.reload();
  });
  c.on('error', (e) => fail('Connection error: ' + e.type));
}
function host() {
  const code = String(Math.floor(Math.random() * 900000) + 100000);
  peer = new Peer(ID(code));
  peer.on('open', () => { showCode(code); $('#bHost').hidden = true; $('#waiting').hidden = false; waiting(true); });
  peer.on('connection', attach);
  peer.on('error', (e) => { if (e.type === 'unavailable-id') { peer.destroy(); host(); } else fail('Could not reach the matchmaking service (' + e.type + '). Check your internet.'); });
}
$('#bHost').onclick = () => { fail(''); host(); };
function join() {
  const code = jin.map((x) => x.value).join(''); fail(''); $('#joining').hidden = false; waiting(true);
  const reset = (m) => { fail(m); $('#joining').hidden = true; waiting(false); const g = $('#joinDigits'); g.classList.remove('shake'); void g.offsetWidth; g.classList.add('shake'); jin.forEach((x) => (x.value = '')); jin[0].focus(); };
  peer = new Peer();
  const timer = setTimeout(() => reset('Could not connect. The network may block device-to-device traffic.'), 20000);
  peer.on('open', () => { const c = peer.connect(ID(code), OPTS); attach(c); c.on('open', () => clearTimeout(timer)); });
  peer.on('error', (e) => { clearTimeout(timer); reset(e.type === 'peer-unavailable' ? 'No device found with that code. Check the digits.' : 'Could not reach the matchmaking service (' + e.type + ').'); });
}

/* ---------- activity cards ---------- */
const rate = (t0, b, total) => { const s = (performance.now() - t0) / 1000 || .001, r = b / s, eta = (total - b) / r; return `${size(b)} of ${size(total)} · ${size(r)}/s · ${eta < 1 ? 'almost done' : Math.ceil(eta) + 's left'}`; };
function thumb(ico, url) { ico.style.backgroundImage = `url(${url})`; ico.textContent = ''; }
function item(dir, name, sz, imgUrl) {
  const e = $('#log .empty'); if (e) e.remove();
  const ext = (name.includes('.') ? name.split('.').pop() : 'file').slice(0, 4).toUpperCase();
  let h = 0; for (const ch of ext) h = (h * 31 + ch.charCodeAt(0)) % 360;
  const r = mk('div', 'item ' + dir, '<div class="ico"></div><div class="meta"><div class="name"></div><div class="sub"></div><div class="bar"><i></i></div></div><div class="act"></div>');
  const ico = r.querySelector('.ico'), sub = r.querySelector('.sub'), bar = r.querySelector('.bar i'), act = r.querySelector('.act');
  ico.style.setProperty('--h', h); ico.textContent = ext; if (imgUrl) thumb(ico, imgUrl);
  r.querySelector('.name').textContent = name; $('#log').prepend(r);
  let last = 0;
  return {
    set(b, txt) { const t = performance.now(); if (t - last < 90) return; last = t; bar.style.width = (sz ? b / sz * 100 : 100) + '%'; sub.textContent = txt; },
    done(txt, blob) {
      r.classList.add('done'); bar.style.width = '100%'; sub.textContent = txt; act.innerHTML = IC.chk;
      if (blob) { const a = mk('a', 'btn sm', 'Save'); a.href = URL.createObjectURL(blob); a.download = name; act.prepend(a); if (blob.type.startsWith('image/')) thumb(ico, a.href); }
    },
    bad(t) { r.classList.add('fail'); sub.textContent = t; },
  };
}
function textItem(dir, text) {
  const e = $('#log .empty'); if (e) e.remove();
  const r = mk('div', 'item ' + dir, '<div class="ico" style="--h:200">Aa</div><div class="meta"><div class="sub"></div><p class="txt"></p></div><div class="act"></div>');
  r.querySelector('.sub').textContent = dir === 'in' ? 'Message received' : 'Message sent';
  const p = r.querySelector('.txt');
  text.split(/(https?:\/\/[^\s]+)/g).forEach((part, i) => { if (i % 2) { const a = mk('a'); a.href = part; a.target = '_blank'; a.rel = 'noopener noreferrer'; a.textContent = part; p.append(a); } else p.append(part); });
  if (dir === 'in') { const b = mk('button', 'btn sm alt', 'Copy'); b.onclick = async () => { try { await navigator.clipboard.writeText(text); b.textContent = 'Copied'; } catch {} }; r.querySelector('.act').append(b); }
  else r.querySelector('.act').innerHTML = IC.chk;
  $('#log').prepend(r);
}

/* ---------- receiving ---------- */
function onMsg(ev) {
  if (typeof ev.data !== 'string') {
    if (!cur) return; cur.chunks.push(ev.data); cur.got += ev.data.byteLength;
    cur.it.set(cur.got, rate(cur.t0, cur.got, cur.size)); return;
  }
  const m = JSON.parse(ev.data);
  if (m.t === 'hello') { $('#peerName').textContent = m.name; $('#peerOrb').innerHTML = IC[m.kind] || IC.laptop; }
  else if (m.t === 'file-start') { flow('in', 1); cur = { ...m, chunks: [], got: 0, t0: performance.now(), it: item('in', m.name, m.size) }; }
  else if (m.t === 'file-end' && cur) {
    const blob = new Blob(cur.chunks, { type: cur.type || 'application/octet-stream' });
    cur.it.done('Received · ' + size(blob.size), blob); flow('in', -1); cur = null;
  } else if (m.t === 'text') textItem('in', m.text);
}

/* ---------- sending ---------- */
async function sendFiles(files) {
  for (const f of files) {
    const it = item('out', f.name, f.size, f.type.startsWith('image/') ? URL.createObjectURL(f) : null), t0 = performance.now();
    flow('out', 1);
    try {
      dc.send(JSON.stringify({ t: 'file-start', name: f.name, size: f.size, type: f.type }));
      for (let o = 0; o < f.size; o += CHUNK) {
        if (dc.bufferedAmount > HIGH) await new Promise((res) => dc.addEventListener('bufferedamountlow', res, { once: true }));
        dc.send(await f.slice(o, o + CHUNK).arrayBuffer());
        const b = Math.min(o + CHUNK, f.size); it.set(b, rate(t0, b, f.size));
      }
      dc.send(JSON.stringify({ t: 'file-end' }));
      while (dc.bufferedAmount > 0) await new Promise((res) => setTimeout(res, 50));
      it.done('Sent · ' + size(f.size));
    } catch (e) { it.bad('Failed: ' + e.message); }
    flow('out', -1);
  }
}
$('#drop').onclick = () => $('#picker').click();
$('#drop').onkeydown = (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); $('#picker').click(); } };
$('#picker').onchange = (e) => { sendFiles([...e.target.files]); e.target.value = ''; };
addEventListener('dragover', (e) => { e.preventDefault(); if (!$('#app').hidden) document.body.classList.add('dragging'); });
addEventListener('dragleave', (e) => { if (!e.relatedTarget) document.body.classList.remove('dragging'); });
addEventListener('drop', (e) => { e.preventDefault(); document.body.classList.remove('dragging'); if (!$('#app').hidden && e.dataTransfer.files.length) sendFiles([...e.dataTransfer.files]); });
const sendText = () => { const v = $('#text').value.trim(); if (!v) return; dc.send(JSON.stringify({ t: 'text', text: v })); textItem('out', v); $('#text').value = ''; };
$('#bText').onclick = sendText; $('#text').onkeydown = (e) => { if (e.key === 'Enter') sendText(); };
</script>
</body>
</html>
